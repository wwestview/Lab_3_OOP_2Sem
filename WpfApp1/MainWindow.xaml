<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Source="C:\Users\Nazar\Desktop\MathAnalys\StudyUni\WpfApp1\WpfApp1\bin\Debug\net8.0-windows\maxresdefault.jpg" Stretch="UniformToFill" Grid.RowSpan="2" Panel.ZIndex="0"/>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10" Panel.ZIndex="1">
            <WrapPanel>
                <TextBlock Text="A" Margin="5" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="FromTextBox" Width="100" Text="123" Margin="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="B" Margin="5" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="ToTextBox" Width="100" Text="987564" Margin="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="Kрок" Margin="5" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="StepTextBox" Width="100" Text="12345" Margin="5" VerticalContentAlignment="Center"/>

                <Button Content="Треба більше кнопок!" Click="GenerateButtons_Click" Margin="5" Padding="5,2"/>
            </WrapPanel>

            <WrapPanel Margin="0,5,5,5">
                <TextBlock Text="А чи не вилучити мені всі кнопки, кратні..." VerticalAlignment="Center" Foreground="White"/>
                <TextBox x:Name="MultipleTextBox" Width="100" Margin="5" VerticalContentAlignment="Center"/>
                <Button Content="Вилучити" Click="RemoveMultiples_Click" Margin="5" Padding="5,2"/>
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" Panel.ZIndex="1" Margin="10,0,10,10">
            <ItemsControl ItemsSource="{Binding Numbers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                Margin="3"
                                Padding="5"
                                MinWidth="30"
                                Click="NumberButton_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>